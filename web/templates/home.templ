package templates

templ Home() {
	@Layout("Home") {
		<div class="container mx-auto px-4 py-8">
			<!-- Header -->
			<header class="text-center mb-12">
				<h1 class="text-5xl font-bold mb-4" style="font-family: 'Press Start 2P', cursive; color: #FF10F0; text-shadow: 0 0 10px #FF10F0;">
					🐹 IDEA HAMSTER
				</h1>
				<p class="text-xl" style="font-family: 'VT323', monospace; color: #00FFFF;">
					Your Ideas. Our Hamster. Pure 90's Magic!
				</p>
				<div class="mt-4 inline-block border-2 border-cyan-400 px-4 py-2 animate-pulse">
					<span style="color: #00FFFF;">⚡ PHASE 1: COMMUNITY VALIDATION ⚡</span>
				</div>
			</header>

			<!-- Coming Soon -->
			<div class="max-w-2xl mx-auto text-center">
				<div class="border-4 border-pink-500 bg-purple-900 bg-opacity-50 p-8 mb-8" style="box-shadow: 0 0 20px #FF10F0;">
					<h2 class="text-3xl mb-4" style="font-family: 'Press Start 2P', cursive; color: #9D00FF;">
						UNDER CONSTRUCTION
					</h2>
					<div class="mb-6">
						<img src="https://web.archive.org/web/19961112175707im_/http://www.ani-gif.com/construction.gif"
							alt="Under Construction"
							class="mx-auto"
							style="image-rendering: pixelated;"/>
					</div>
					<p class="text-lg mb-4" style="font-family: 'VT323', monospace;">
						The hamster is working hard to build the leaderboard!
					</p>
					<p class="text-sm" style="color: #00FFFF;">
						Coming soon: Submit ideas, vote, and watch them get built! 🚀
					</p>
				</div>

				<!-- Feature Preview -->
				<div class="grid md:grid-cols-3 gap-4 text-sm">
					<div class="border-2 border-cyan-400 p-4 bg-gray-800">
						<h3 class="font-bold mb-2" style="color: #00FFFF;">SUBMIT IDEAS</h3>
						<p>Share your app concepts with the community</p>
					</div>
					<div class="border-2 border-pink-500 p-4 bg-gray-800">
						<h3 class="font-bold mb-2" style="color: #FF10F0;">VOTE & RANK</h3>
						<p>Vote on your favorites. Top ideas get built!</p>
					</div>
					<div class="border-2 border-purple-500 p-4 bg-gray-800">
						<h3 class="font-bold mb-2" style="color: #9D00FF;">WATCH IT BUILD</h3>
						<p>50 votes = Build eligibility!</p>
					</div>
				</div>
			</div>

			<!-- Footer -->
			<footer class="mt-16 text-center text-sm" style="color: #00FFFF;">
				<p>Built with Go + Templ + HTMX + Tailwind 💚</p>
				<p class="mt-2">
					<a href="https://github.com/abhishekrajuchamarthi/idea-hamster"
						class="underline hover:text-pink-500">
						View on GitHub
					</a>
				</p>
			</footer>
		</div>
	}
}
