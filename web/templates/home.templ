package templates

templ Home() {
	@Layout("Home") {
		<div class="container mx-auto px-4 py-8">
			<!-- Header -->
			<header class="text-center mb-12">
				<h1 class="text-5xl font-pixel mb-4 neon-glow-blue text-neon-blue">
					🐹 IDEA HAMSTER
				</h1>
				<p class="text-xl font-retro text-neon-coral">
					Your Ideas. Our Hamster. Pure 90's Magic!
				</p>
				<div class="mt-4 inline-block border-2 border-neon-purple px-4 py-2 animate-pulse">
					<span class="text-neon-purple">⚡ PHASE 1: COMMUNITY VALIDATION ⚡</span>
				</div>
			</header>

			<!-- Coming Soon -->
			<div class="max-w-2xl mx-auto text-center">
				<div class="border-4 border-neon-coral bg-purple-900 bg-opacity-50 p-8 mb-8 shadow-lg shadow-neon-coral/30">
					<h2 class="text-3xl mb-4 font-pixel neon-glow-purple text-neon-purple">
						UNDER CONSTRUCTION
					</h2>
					<div class="mb-6">
						<img src="https://web.archive.org/web/19961112175707im_/http://www.ani-gif.com/construction.gif"
							alt="Under Construction"
							class="mx-auto"
							style="image-rendering: pixelated;"/>
					</div>
					<p class="text-lg mb-4 font-retro text-gray-300">
						The hamster is working hard to build the leaderboard!
					</p>
					<p class="text-sm text-neon-blue">
						Coming soon: Submit ideas, vote, and watch them get built! 🚀
					</p>
				</div>

				<!-- Feature Preview -->
				<div class="grid md:grid-cols-3 gap-4 text-sm">
					<div class="border-2 border-neon-blue p-4 bg-gray-800">
						<h3 class="font-bold mb-2 text-neon-blue">SUBMIT IDEAS</h3>
						<p class="text-gray-300">Share your app concepts with the community</p>
					</div>
					<div class="border-2 border-neon-coral p-4 bg-gray-800">
						<h3 class="font-bold mb-2 text-neon-coral">VOTE & RANK</h3>
						<p class="text-gray-300">Vote on your favorites. Top ideas get built!</p>
					</div>
					<div class="border-2 border-neon-purple p-4 bg-gray-800">
						<h3 class="font-bold mb-2 text-neon-purple">WATCH IT BUILD</h3>
						<p class="text-gray-300">50 votes = Build eligibility!</p>
					</div>
				</div>
			</div>

			<!-- Footer -->
			<footer class="mt-16 text-center text-sm text-neon-teal">
				<p>Built with Go + Templ + HTMX + Tailwind 💚</p>
				<p class="mt-2">
					<a href="https://github.com/abhi10/idea-hamster"
						class="underline hover:text-neon-coral transition-colors">
						View on GitHub
					</a>
				</p>
			</footer>
		</div>
	}
}
